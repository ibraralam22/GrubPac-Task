# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/taskflow_db?schema=public

# Redis Configuration (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets
JWT_ACCESS_SECRET=taskflow_jwt_access_secret_key_super_secure_2026_minimum_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=taskflow_jwt_refresh_secret_key_super_secure_2026_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Security & Hashing
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=10
