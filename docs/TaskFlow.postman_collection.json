            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Assign Task (Async BullMQ Queue Dispatch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.job && jsonData.job.id) {",
                  "    pm.collectionVariables.set('jobId', jsonData.job.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"0a3a94da-b51d-4886-b9d9-5ccefdbef225\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}", "assign"]
            }
          }
        },
        {
          "name": "Bulk Status Update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskIds\": [\"{{taskId}}\"],\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/bulk-status",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "bulk-status"]
            }
          }
        }
      ]
    },
